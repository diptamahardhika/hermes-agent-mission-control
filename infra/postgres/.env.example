# ─── Hermy HQ Self-Hosted PostgreSQL Stack ───────────────────────────
# Copy to .env and fill in your values

# PostgreSQL (primary database)
POSTGRES_PASSWORD=generate_with_openssl_rand_base64_32

# pgBackRest encryption key (for encrypted backups) — only needed if pgBackRest is re-enabled
# PGBACKREST_REPO_KEY=generate_with_openssl_rand_base64_32

# pgAdmin web UI — must be a valid email address (pgAdmin 8+ rejects .local TLDs)
PGADMIN_EMAIL=admin@hermy.dev
PGADMIN_PASSWORD=generate_with_openssl_rand_base64_32

# ─── Connection Strings for Hermy HQ ─────────────────────────────────
# Direct connection (for migrations, admin)
# DATABASE_URL=postgresql://hermy:${POSTGRES_PASSWORD}@localhost:5432/hermy_hq?sslmode=prefer

# Pooled connection (for application - USE THIS ONE)
# DATABASE_URL=postgresql://hermy:${POSTGRES_PASSWORD}@localhost:6432/hermy_hq?sslmode=disable&pgbouncer=true

# For hermes-bridge (same as app, but direct is fine since it's local)
# HERMES_DATABASE_URL=postgresql://hermy:${POSTGRES_PASSWORD}@localhost:5432/hermy_hq?sslmode=prefer