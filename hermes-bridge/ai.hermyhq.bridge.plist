<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd service for the Hermy HQ ↔ Hermes bridge.
  Logs: /tmp/hermes-bridge.out.log  /tmp/hermes-bridge.err.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermyhq.bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>/Users/pradiptamahardika/hermes-agent-mission-control/hermes-bridge/bridge.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- DATABASE_URL is NOT stored here. bridge.mjs loads it from
         hermes-bridge/.env (gitignored). See bridge.mjs. -->
    <key>HERMES_BOARD</key>
    <string>default</string>
    <!-- Briefs routinely run 2-10 min. The 600s default killed healthy runs at exactly 10 min. -->
    <key>BRIDGE_RUN_TIMEOUT_MS</key>
    <string>900000</string>
    <key>HERMES_BIN</key>
    <string>/Users/pradiptamahardika/.local/bin/hermes</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/pradiptamahardika/.local/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/hermes-bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hermes-bridge.err.log</string>
</dict>
</plist>
